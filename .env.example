POSTGRES_DB=vera
POSTGRES_USER=vera
POSTGRES_PASSWORD=vera

# Used by local commands running on the host machine.
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5433/${POSTGRES_DB}

# Used by the API container to reach PostgreSQL on the Compose network.
DATABASE_URL_DOCKER=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

LLM_API_KEY=
EMAIL_API_KEY=
JWT_SECRET=development-only-change-me

EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-base
CHUNK_SIZE_TOKENS=400
CHUNK_OVERLAP_TOKENS=50
EVIDENCE_CONFIDENCE_THRESHOLD=0.65

