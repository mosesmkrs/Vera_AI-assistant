POSTGRES_DB=vera
POSTGRES_USER=vera
POSTGRES_PASSWORD=vera

# Used by local commands running on the host machine.
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5433/${POSTGRES_DB}

# Used by the API container to reach PostgreSQL on the Compose network.
DATABASE_URL_DOCKER=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

LLM_API_KEY=
LLM_PROVIDER=openai
LLM_MODEL=gpt-6-luna
# Gmail: smtp.gmail.com, port 587 with STARTTLS; use a Google App Password.
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_USE_SSL=false
EMAIL_FROM_NAME=Vera
EMAIL_FROM=
EMAIL_REPLY_TO=
JWT_SECRET=development-only-change-me

EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-base
CHUNK_SIZE_TOKENS=400
CHUNK_OVERLAP_TOKENS=50
EVIDENCE_CONFIDENCE_THRESHOLD=0.55
ANSWER_CONFIDENCE_MEDIUM_THRESHOLD=0.65
ANSWER_CONFIDENCE_HIGH_THRESHOLD=0.85

